# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Every value below is a placeholder or a public,
# non-secret default. Never put a private key or mnemonic in this file: this
# application only performs read-only calls and never needs one.
# ---------------------------------------------------------------------------

# Pharos Chain MCP endpoint (Streamable HTTP, JSON-RPC 2.0).
# Hosted, read-only, no API key required. Rate limit: 120 requests/minute per IP.
PHAROS_MCP_ENDPOINT=https://mcp.pharos.xyz/mcp

# Pharos Pacific Mainnet JSON-RPC endpoint. Reported for reference/verification;
# all contract reads go through the Chain MCP endpoint above.
PHAROS_RPC_URL=https://rpc.pharos.xyz

# Expected chain ID. The app aborts if the MCP server reports a different chain.
PHAROS_CHAIN_ID=1672

# Contract to inspect. Default is the Circle-deployed USDC token documented in
# the Pharos Pacific Mainnet token registry.
CONTRACT_ADDRESS=0xC879C018dB60520F4355C26eD1a6D572cdAC1815

# Address used as the `balanceOf` argument.
HOLDER_ADDRESS=0x912c9aDe24D44d8922f0866D8Dcb079f1363f647

# Address used as the `allowance` spender argument.
SPENDER_ADDRESS=0xf38d34c8382b9079b0f85309578b43b8479Cd875

# Pin every read to one block. Leave empty to pin to the latest block observed
# at startup (recommended). Accepts a decimal block number or tag.
BLOCK_NUMBER=

# Request timeout for a single MCP call, in milliseconds.
MCP_TIMEOUT_MS=20000

# Retries when the MCP endpoint answers HTTP 429 (Retry-After is honoured).
MCP_MAX_RETRIES=2

# Set to "0" to skip the multi-token registry sweep.
READ_REGISTRY=1
